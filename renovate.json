{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended"
    ],
    "ignorePaths": [
        ".github/**"
    ],
    "forkProcessing": "enabled",
    "pruneStaleBranches": true,
    "pruneBranchAfterAutomerge": true,
    "minimumReleaseAge": "24 hours",
    "statusCheckNames": {
        "minimumReleaseAge": null
    },
    "internalChecksFilter": "strict",
    "prCreation": "immediate",
    "timezone": "Asia/Shanghai",
    "schedule": [
        "every weekend"
    ],
    "dependencyDashboard": true,
    "dependencyDashboardTitle": "Dependency Dashboard",
    "dependencyDashboardHeader": "This issue lists Renovate updates and detected dependencies. Force an update by checking the boxes.",
    "dependencyDashboardApproval": false,
    "baseBranchPatterns": [
        "beta"
    ],
    "packageRules": [
        {
            "matchUpdateTypes": [
                "minor",
                "patch"
            ],
            "recreateWhen": "always",
            "groupName": "other non-major dependencies",
            "groupSingleUpdates": false,
            "groupSlug": "all-minor-patch",
            "commitMessageExtra": "",
            "matchPackageNames": [
                "!/^androidx\\./",
                "!/^org\\.jetbrains\\.kotlin/",
                "!/^io\\.insert-koin\\./",
                "!/^org\\.junit\\./",
                "!/^dev\\.chrisbanes\\.haze/",
                "!/^com\\.squareup\\.okhttp3/",
                "!/^com\\.squareup\\.retrofit2/",
                "!/^io\\.ktor\\./",
                "!/^io\\.coil-kt/",
                "!/^io\\.kotest/",
                "!/^com\\.google\\.firebase/"
            ]
        },
        {
            "matchManagers": [
                "gradle",
                "maven"
            ],
            "addLabels": [
                "dependencies",
                "java"
            ]
        },
        {
            "matchManagers": [
                "npm"
            ],
            "addLabels": [
                "dependencies",
                "javascript"
            ]
        },
        {
            "matchManagers": [
                "github-actions"
            ],
            "addLabels": [
                "dependencies",
                "github_actions"
            ]
        },
        {
            "matchManagers": [
                "cargo"
            ],
            "addLabels": [
                "dependencies",
                "rust"
            ]
        },
        {
            "matchPackageNames": [
                "int:LOG_LEVEL",
                "int:MODULE_VERSION",
                "int:VERSION_CODE"
            ],
            "enabled": false
        },
        {
            "description": "The root Gradle force block is maintained by dependency-force-manager, not Renovate.",
            "matchManagers": [
                "gradle"
            ],
            "matchFileNames": [
                "build.gradle.kts"
            ],
            "enabled": false
        }
    ],
    "osvVulnerabilityAlerts": true,
    "vulnerabilityAlerts": {
        "enabled": true,
        "labels": ["security"]
    }
}
