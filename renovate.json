{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended"
    ],
    "ignorePaths": [
        ".github/**"
    ],
    "forkProcessing": "enabled",
    "pruneStaleBranches": true,
    "pruneBranchAfterAutomerge": true,
    "minimumReleaseAge": "24 hours",
    "internalChecksFilter": "strict",
    "prCreation": "immediate",
    "ignoreTests": true,
    "platformAutomerge": false,
    "automergeType": "pr",
    "baseBranchPatterns": [
        "beta"
    ],
    "ignoreDeps": [
        "rustls:rustls-platform-verifier",
        "org.matrix.rustcomponents:sdk-android"
    ],
    "packageRules": [
        {
            "matchManagers": [
                "gradle",
                "maven"
            ],
            "matchUpdateTypes": [
                "minor"
            ],
            "automerge": true,
            "automergeType": "pr",
            "groupName": "java minor dependencies",
            "groupSingleUpdates": false,
            "groupSlug": "java-minor",
            "commitMessageExtra": ""
        },
        {
            "matchManagers": [
                "gradle",
                "maven"
            ],
            "matchUpdateTypes": [
                "patch"
            ],
            "automerge": true,
            "automergeType": "pr",
            "groupName": "java patch dependencies",
            "groupSingleUpdates": false,
            "groupSlug": "java-patch",
            "commitMessageExtra": ""
        },
        {
            "matchManagers": [
                "npm",
                "pnpm"
            ],
            "matchUpdateTypes": [
                "minor"
            ],
            "automerge": true,
            "automergeType": "pr",
            "groupName": "javascript minor dependencies",
            "groupSingleUpdates": false,
            "groupSlug": "javascript-minor",
            "commitMessageExtra": ""
        },
        {
            "matchManagers": [
                "npm",
                "pnpm"
            ],
            "matchUpdateTypes": [
                "patch"
            ],
            "automerge": true,
            "automergeType": "pr",
            "groupName": "javascript patch dependencies",
            "groupSingleUpdates": false,
            "groupSlug": "javascript-patch",
            "commitMessageExtra": ""
        },
        {
            "matchManagers": [
                "cargo"
            ],
            "matchUpdateTypes": [
                "minor"
            ],
            "automerge": true,
            "automergeType": "pr",
            "groupName": "rust minor dependencies",
            "groupSingleUpdates": false,
            "groupSlug": "rust-minor",
            "commitMessageExtra": ""
        },
        {
            "matchManagers": [
                "cargo"
            ],
            "matchUpdateTypes": [
                "patch"
            ],
            "automerge": true,
            "automergeType": "pr",
            "groupName": "rust patch dependencies",
            "groupSingleUpdates": false,
            "groupSlug": "rust-patch",
            "commitMessageExtra": ""
        },
        {
            "matchManagers": [
                "gomod"
            ],
            "matchUpdateTypes": [
                "minor"
            ],
            "automerge": true,
            "automergeType": "pr",
            "groupName": "go minor dependencies",
            "groupSingleUpdates": false,
            "groupSlug": "go-minor",
            "commitMessageExtra": ""
        },
        {
            "matchManagers": [
                "gomod"
            ],
            "matchUpdateTypes": [
                "patch"
            ],
            "automerge": true,
            "automergeType": "pr",
            "groupName": "go patch dependencies",
            "groupSingleUpdates": false,
            "groupSlug": "go-patch",
            "commitMessageExtra": ""
        },
        {
            "matchManagers": [
                "docker-compose",
                "dockerfile",
                "gitlabci",
                "gitlabci-include",
                "gradle-wrapper"
            ],
            "matchUpdateTypes": [
                "minor"
            ],
            "automerge": true,
            "automergeType": "pr",
            "groupName": "infra minor dependencies",
            "groupSingleUpdates": false,
            "groupSlug": "infra-minor",
            "commitMessageExtra": ""
        },
        {
            "matchManagers": [
                "docker-compose",
                "dockerfile",
                "gitlabci",
                "gitlabci-include",
                "gradle-wrapper"
            ],
            "matchUpdateTypes": [
                "patch"
            ],
            "automerge": true,
            "automergeType": "pr",
            "groupName": "infra patch dependencies",
            "groupSingleUpdates": false,
            "groupSlug": "infra-patch",
            "commitMessageExtra": ""
        },
        {
            "matchManagers": [
                "gradle",
                "maven"
            ],
            "addLabels": [
                "dependencies",
                "java"
            ]
        },
        {
            "matchManagers": [
                "npm",
                "pnpm"
            ],
            "addLabels": [
                "dependencies",
                "javascript"
            ]
        },
        {
            "matchManagers": [
                "github-actions"
            ],
            "addLabels": [
                "dependencies",
                "github_actions"
            ]
        },
        {
            "matchManagers": [
                "cargo"
            ],
            "addLabels": [
                "dependencies",
                "rust"
            ]
        },
        {
            "matchPackageNames": [
                "int:LOG_LEVEL",
                "int:MODULE_VERSION",
                "int:VERSION_CODE"
            ],
            "enabled": false
        },
        {
            "description": "The root Gradle force block is maintained by dependency-force-manager, not Renovate.",
            "matchManagers": [
                "gradle"
            ],
            "matchFileNames": [
                "build.gradle.kts"
            ],
            "enabled": false
        }
    ],
    "osvVulnerabilityAlerts": true,
    "vulnerabilityAlerts": {
        "enabled": true,
        "labels": ["security"]
    },
    "timezone": "Asia/Shanghai",
    "dependencyDashboard": true,
    "dependencyDashboardOSVVulnerabilitySummary": "all",
    "lockFileMaintenance": {
        "enabled": true,
        "automerge": true
    }
}
